@inherits LayoutComponentBase

<div class="app">
    <AuthorizeView>
        <Authorized>
            <header class="topbar">
                <span class="brand">🥘 Madplan</span>
                <span class="who">@context.User.Identity?.Name</span>
            </header>

            <main>@Body</main>

            <nav class="tabs">
                <NavLink href="/" Match="NavLinkMatch.All"><span>🍽️</span>I dag</NavLink>
                <NavLink href="/uge"><span>📅</span>Uge</NavLink>
                <NavLink href="/budget"><span>🎯</span>Budget</NavLink>
                <NavLink href="/opskrifter"><span>📖</span>Retter</NavLink>
                <NavLink href="/indkoeb"><span>🛒</span>Indkøb</NavLink>
            </nav>
        </Authorized>
        <NotAuthorized>
            <main class="plain">@Body</main>
        </NotAuthorized>
    </AuthorizeView>
</div>
