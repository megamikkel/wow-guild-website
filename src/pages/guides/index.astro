---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";

const guides = await Astro.glob("../../content/guides/*.md");

function byDateDesc(a, b) {
  const da = new Date(a.frontmatter.date).getTime();
  const db = new Date(b.frontmatter.date).getTime();
  return db - da;
}

const sorted = guides.sort(byDateDesc);
---
<BaseLayout title="Guides" description="Guides og strategi">
  <Nav />
  <Section eyebrow="Guides" title="Guides i menneskesprog">
    <div class="grid cols-3" style="margin-top: 12px;">
      {sorted.map((g) => (
        <Card
          title={g.frontmatter.title}
          desc={g.frontmatter.summary}
          meta={`${g.frontmatter.date}`}
          href={`/guides/${g.file.split("/").pop().replace(".md", "")}`}
        />
      ))}
    </div>
  </Section>
  <Footer />
</BaseLayout>
