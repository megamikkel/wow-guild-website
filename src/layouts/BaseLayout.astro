---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description ?? "Officiel guild-side"} />
    <title>{title ? `${title} • Guild` : "Guild"}</title>

    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
