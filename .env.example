# Kopiér denne fil til «.env» og udfyld. Filen .env er i .gitignore og
# kommer aldrig i git.
#
# Skriv værdierne direkte efter lighedstegnet. Anførselstegn er valgfrie —
# brug dem hvis værdien indeholder mellemrum.


# --- Jeres logins TIL APPEN --------------------------------------------------
# Det er brugere I selv opfinder. De har intet med nemlig at gøre.
# Format: Navn:mail:kodeord  — flere adskilles med semikolon.
MADPLAN_USERS=Mikkel:mikkel@example.dk:vaelg-et-kodeord;Partner:partner@example.dk:et-andet

# --- Jeres nemlig-konto ------------------------------------------------------
# Det I logger ind med på nemlig.com. Bruges kun til at LÆSE priser —
# appen skriver aldrig noget til nemlig.
#
# Lad dem stå tomme for at køre uden priser: madplan, opskrifter og
# indkøbsliste virker stadig.
NEMLIG_USERNAME=
NEMLIG_PASSWORD=

# --- Database ----------------------------------------------------------------
# Én fil. Backup er at kopiere den.
MADPLAN_DB_PATH=madplan.db
