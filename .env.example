# Kopiér til .env og udfyld. .env er i .gitignore og må ALDRIG committes.

# --- Brugere -----------------------------------------------------------------
# Format: "Navn:mail:kodeord;Navn2:mail2:kodeord2"
# Der er ingen offentlig registrering. Brugerne oprettes ved opstart.
MADPLAN_USERS="Mikkel:mikkel@example.com:skift-mig;Partner:partner@example.com:skift-mig-ogsaa"

# --- Database ----------------------------------------------------------------
# Sti til SQLite-filen. Backup er en filkopi.
MADPLAN_DB_PATH=madplan.db

# --- Nemlig ------------------------------------------------------------------
# Lad dem stå tomme for at køre uden nemlig: madplan, opskrifter og indkøbsliste
# virker, priser bliver ukendte og kurv-knappen er slået fra.
NEMLIG_USERNAME=
NEMLIG_PASSWORD=
