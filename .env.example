# ————— PAPI environment —————
# Copy to .env.local and fill in. NEVER commit real values.
# With nothing configured the app runs in demo mode (embedded database +
# realistic fixtures) — perfect for local development.

# Demo mode. "true" forces demo (even in production, e.g. a preview deploy),
# "false" forces real mode. Unset = demo in development when DATABASE_URL is
# missing; production then REQUIRES DATABASE_URL and fails fast without it.
PAPI_DEMO_MODE=

# Postgres connection string (Neon/Supabase/self-hosted).
DATABASE_URL=

# Public site URL (SEO, OpenGraph, sitemap). e.g. https://papi.example
PAPI_SITE_URL=

# Auth.js session encryption secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Bearer secret protecting POST /api/sync (background sync trigger).
# Generate: openssl rand -hex 32
PAPI_SYNC_SECRET=

# ————— Discord (primary identity) —————
# Create an app at https://discord.com/developers/applications
# OAuth2 redirect URL: {PAPI_SITE_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The guild's Discord server id (right-click server → Copy Server ID).
DISCORD_GUILD_ID=
# Discord role id → PAPI role mapping, comma-separated.
# Example: 123456789:ADMIN,234567890:OFFICER,345678901:RAIDER,456789012:TRIAL
DISCORD_ROLE_MAP=
# Webhook for guild notifications (channel settings → integrations → webhooks).
DISCORD_WEBHOOK_URL=

# ————— Battle.net / Blizzard (guild roster, character ownership) —————
# Register a client at https://develop.battle.net
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# ————— Warcraft Logs (reports, boss progress) —————
# Create a v2 client at https://www.warcraftlogs.com/api/clients
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=

# ————— Raid-Helper (events, signups) —————
# Server API key: run /apikey in your Discord server.
RAID_HELPER_API_KEY=
RAID_HELPER_SERVER_ID=

# ————— Raider.IO (M+ scores, raid progression) —————
# Optional — works without a key (200 req/min). Register an app at
# https://raider.io/settings/apps for higher limits.
RAIDERIO_API_KEY=
