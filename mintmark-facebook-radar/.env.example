# Kopiér til .env og udfyld det du har brug for. Ingen Facebook-password her - nogensinde.

# LLM-classifier. Hvis ANTHROPIC_API_KEY mangler, bruges den indbyggede regelbaserede classifier.
ANTHROPIC_API_KEY=
# anthropic | rules  (default: anthropic hvis API-nøgle findes, ellers rules)
RADAR_CLASSIFIER=
# Model til Anthropic-classifieren (default: claude-opus-5)
RADAR_LLM_MODEL=

# Antal opslag der forsøges hentet pr. gruppe (default 50)
RADAR_MAX_POSTS_PER_GROUP=50
# Kør scanning i headless Chromium (default false = synligt browservindue)
RADAR_HEADLESS=false
# Valgfri sti til en Chromium-binær, hvis Playwrights egen ikke skal bruges
RADAR_CHROMIUM_PATH=
# Port til dashboardet (default 3742)
RADAR_PORT=3742

# Stier (defaults relative til projektmappen)
RADAR_DB_PATH=data/radar.db
RADAR_PROFILE_DIR=playwright-profile
RADAR_GROUPS_FILE=config/groups.json
RADAR_LOG_LEVEL=info
